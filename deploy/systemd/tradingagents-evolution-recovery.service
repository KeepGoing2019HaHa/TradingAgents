[Unit]
Description=Resume incomplete MSFT RSI analyses without repeating successes
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/TradingAgents
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/TradingAgents/.venv/bin/python -m cli.main evolution recover
TimeoutStartSec=4h
UMask=0077